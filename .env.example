# Copy to .env.local for local dev. Never commit real values.

# Postgres connection string. Local: embedded PGlite (auto-migrates on start).
# Production: Neon pooled connection string (postgres://...).
DATABASE_URL=pglite:./.pglite

# Session signing secret. Generate with `npx auth secret`.
# Use a DIFFERENT value locally than in production (the dev login can mint
# sessions for any @visibuild.com email).
AUTH_SECRET=

# Google OAuth web client (Internal audience). See README.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 1 = email-only dev login (local only; ignored when NODE_ENV=production).
# Do NOT set this in Vercel.
AUTH_DEV_LOGIN=0

# Slack bot token (xoxb-...) and the coffee club channel ID (C...).
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Shared secret for /api/cron/slack-emoji (Vercel sends it as a Bearer token).
CRON_SECRET=

# Public base URL of the app (no trailing slash).
APP_URL=http://localhost:3000
